# Include after the top-level project() through CMAKE_PROJECT_INCLUDE.
function(itgmania_harness_observe_source name original)
  get_target_property(sources ITGmania SOURCES)
  get_target_property(source_dir ITGmania SOURCE_DIR)
  set(found 0)
  foreach(source IN LISTS sources)
    get_filename_component(base "${source}" NAME)
    if(base STREQUAL name)
      math(EXPR found "${found} + 1")
      list(REMOVE_ITEM sources "${source}")
    endif()
  endforeach()
  if(NOT found EQUAL 1)
    message(FATAL_ERROR "interactive trace requires exactly one ${name}")
  endif()
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/itgmania-harness/${name}")
  file(CONFIGURE OUTPUT "${generated}" CONTENT
    "#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/interactive_trace.h\"\n${original}" @ONLY)
  set_property(TARGET ITGmania PROPERTY SOURCES "${sources}")
  target_sources(ITGmania PRIVATE "${generated}")
endfunction()

function(itgmania_harness_interactive_source name)
  get_target_property(sources ITGmania SOURCES)
  get_target_property(source_dir ITGmania SOURCE_DIR)
  foreach(source IN LISTS sources)
    get_filename_component(base "${source}" NAME)
    if(base STREQUAL name)
      get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${source_dir}")
      file(READ "${path}" original)
    endif()
  endforeach()
  if(NOT DEFINED original)
    message(FATAL_ERROR "interactive trace cannot find ${name}")
  endif()
  if(name STREQUAL "ScreenManager.cpp")
    set(draw_anchor "void ScreenManager::Draw() {")
    string(REPLACE "${draw_anchor}" "${draw_anchor}\n  ItgmaniaHarnessDrawFrame harness_draw_frame;" original "${original}")
    set(anchor "void ScreenManager::Update(float fDeltaTime) {")
    set(replacement "${anchor}\n  itgmania_harness_before_screen_update(fDeltaTime);")
  elseif(name STREQUAL "Screen.cpp")
    set(anchor "  lua_setfield(L, -2, \"MultiPlayer\");")
    set(replacement "${anchor}\n  itgmania_harness_observe_input(L, this);")
  elseif(name STREQUAL "Actor.cpp")
    set(anchor "      this->DrawPrimitives();")
    set(replacement "      Actor* harness_previous = itgmania_harness_draw_actor(this);\n${anchor}\n      itgmania_harness_draw_actor(harness_previous);")
    set(state_anchor "void Actor::SetGlobalRenderStates() {")
    string(REPLACE "${state_anchor}" "${state_anchor}\n  itgmania_harness_render_state(this, m_bZWrite, m_ZTestMode, m_bTextureWrapping, m_bTextureFiltering, m_BlendMode, m_fZBias, m_CullMode);" original "${original}")
  elseif(name STREQUAL "RageDisplay.cpp")
    foreach(primitive Quads QuadStrip Fan Strip Triangles SymmetricQuadStrip)
      set(draw "this->Draw${primitive}Internal(v, iNumVerts);")
      string(FIND "${original}" "${draw}" offset)
      if(offset LESS 0)
        message(FATAL_ERROR "native draw anchor changed: ${primitive}")
      endif()
      string(REPLACE "${draw}" "itgmania_harness_draw_vertices(\"${primitive}\", v, iNumVerts, *GetWorldTop(), *GetViewTop(), *GetProjectionTop(), *GetCentering(), *GetTextureTop());\n  ${draw}" original "${original}")
    endforeach()
    itgmania_harness_observe_source("${name}" "${original}")
    return()
  elseif(name STREQUAL "CrashHandlerChild.cpp")
    # Retain the native crash report while suppressing the desktop dialog.
    get_filename_component(local_dir "${path}" DIRECTORY)
    foreach(header Crash.h CrashHandlerInternal.h)
      string(REPLACE "#include \"${header}\"" "#include \"${local_dir}/${header}\"" original "${original}")
    endforeach()
    set(anchor "  CrashDialog cd(sCrashReport, Data);")
    set(replacement "  if (GetEnvironmentVariableA(\"ITGMANIA_HARNESS_HEADLESS\", nullptr, 0)) return;\n${anchor}")
  elseif(name STREQUAL "GraphicsWindow.cpp")
    # Keep the real WGL renderer and native AFT implementation, but never show
    # or activate its context window during headless graphics observations.
    get_filename_component(local_dir "${path}" DIRECTORY)
    foreach(header GraphicsWindow.h DirectXHelpers.h)
      string(REPLACE "#include \"${header}\"" "#include \"${local_dir}/${header}\"" original "${original}")
    endforeach()
    string(PREPEND original "#include <cstdlib>\nstatic bool harness_headless_graphics() { return std::getenv(\"ITGMANIA_HARNESS_HEADLESS_GRAPHICS\") != nullptr; }\n")
    foreach(call "SetForegroundWindow(hWnd)" "SetForegroundWindow(g_hWndMain)"
        "ShowWindow(g_hWndMain, SW_SHOWNORMAL)" "ShowWindow(g_hWndMain, SW_SHOWMINNOACTIVE)")
      string(FIND "${original}" " ${call}" offset)
      if(offset LESS 0)
        message(FATAL_ERROR "headless graphics window anchor changed: ${call}")
      endif()
      string(REPLACE " ${call}" " if (!harness_headless_graphics()) ${call}" original "${original}")
    endforeach()
    set(anchor "SWP_FRAMECHANGED | SWP_SHOWWINDOW")
    set(replacement "SWP_FRAMECHANGED | (harness_headless_graphics() ? SWP_NOACTIVATE : SWP_SHOWWINDOW)")
  endif()
  string(FIND "${original}" "${anchor}" offset)
  if(offset LESS 0)
    message(FATAL_ERROR "native interactive anchor changed: ${name}")
  endif()
  string(REPLACE "${anchor}" "${replacement}" original "${original}")
  itgmania_harness_observe_source("${name}" "${original}")
endfunction()

function(itgmania_harness_trace_adapter)
  # Compile an observed copy; never patch the checked-out reference tree.
  get_target_property(sources ITGmania SOURCES)
  get_target_property(source_dir ITGmania SOURCE_DIR)
  set(actor_util_count 0)
  foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "ActorUtil.cpp")
      math(EXPR actor_util_count "${actor_util_count} + 1")
      get_filename_component(actor_util "${source}" ABSOLUTE BASE_DIR "${source_dir}")
      list(REMOVE_ITEM sources "${source}")
    endif()
  endforeach()
  if(NOT actor_util_count EQUAL 1)
    message(FATAL_ERROR "trace adapter requires exactly one native ActorUtil.cpp")
  endif()
  file(READ "${actor_util}" original)
  set(anchor "  pRet->LoadFromNode(&node);")
  # Exclude the semicolon: CMake treats it as a list separator in MATCHALL.
  string(REGEX MATCHALL "  pRet->LoadFromNode\\(&node\\)" anchors "${original}")
  list(LENGTH anchors anchor_count)
  if(NOT anchor_count EQUAL 1)
    message(FATAL_ERROR "native actor creation observer anchor changed")
  endif()
  string(REPLACE "${anchor}" "  itgmania_harness_actor_created(pRet, &node);\n${anchor}" observed "${original}")
  if(observed STREQUAL original)
    message(FATAL_ERROR "native actor creation observer insertion failed")
  endif()
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/itgmania-harness/ActorUtil.cpp")
  file(CONFIGURE OUTPUT "${generated}" CONTENT
    "class Actor;\nclass XNode;\nvoid itgmania_harness_actor_created(Actor*, const XNode*);\n${observed}" @ONLY)
  set_property(TARGET ITGmania PROPERTY SOURCES "${sources}")
  target_sources(ITGmania PRIVATE "${generated}")
  target_sources(ITGmania PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/trace_adapter.cpp")
  target_sources(ITGmania PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/interactive_trace.cpp")
  foreach(name ScreenManager.cpp Screen.cpp Actor.cpp RageDisplay.cpp)
    itgmania_harness_interactive_source("${name}")
  endforeach()
  if(WIN32)
    itgmania_harness_interactive_source("GraphicsWindow.cpp")
    itgmania_harness_interactive_source("CrashHandlerChild.cpp")
  endif()
  # Retain the stock executable for historical captures and independent checks.
  set(ITGMANIA_HARNESS_TRACE_NAME "ITGmania-harness-trace" CACHE STRING "Separate native trace executable name")
  set_target_properties(ITGmania PROPERTIES OUTPUT_NAME_RELEASE "${ITGMANIA_HARNESS_TRACE_NAME}")
  if(MSVC)
    # Upstream's mapconv command still writes the original product filename.
    # CrashHandler looks for a sidecar matching this adapter's executable.
    add_custom_target(itgmania-harness-crash-symbols
      DEPENDS ITGmania
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "$<TARGET_FILE_DIR:ITGmania>/ITGmania.vdi"
        "$<TARGET_FILE_DIR:ITGmania>/${ITGMANIA_HARNESS_TRACE_NAME}.vdi")
  endif()
endfunction()
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  cmake_language(DEFER CALL itgmania_harness_trace_adapter)
endif()
