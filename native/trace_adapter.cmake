# Include after the top-level project() through CMAKE_PROJECT_INCLUDE.
function(itgmania_harness_observe_source name original)
  get_target_property(sources ITGmania SOURCES)
  get_target_property(source_dir ITGmania SOURCE_DIR)
  set(found 0)
  foreach(source IN LISTS sources)
    get_filename_component(base "${source}" NAME)
    if(base STREQUAL name)
      math(EXPR found "${found} + 1")
      list(REMOVE_ITEM sources "${source}")
    endif()
  endforeach()
  if(NOT found EQUAL 1)
    message(FATAL_ERROR "interactive trace requires exactly one ${name}")
  endif()
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/itgmania-harness/${name}")
  # The X11 window wrapper needs no engine observer declarations. In particular,
  # the engine's Screen class would conflict with Xlib's Screen typedef.
  if(name STREQUAL "LowLevelWindow_X11.cpp")
    set(observer_header "")
  else()
    set(observer_header "#include \"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/interactive_trace.h\"\n")
  endif()
  file(CONFIGURE OUTPUT "${generated}" CONTENT "${observer_header}${original}" @ONLY)
  set_property(TARGET ITGmania PROPERTY SOURCES "${sources}")
  target_sources(ITGmania PRIVATE "${generated}")
endfunction()

function(itgmania_harness_interactive_source name)
  get_target_property(sources ITGmania SOURCES)
  get_target_property(source_dir ITGmania SOURCE_DIR)
  foreach(source IN LISTS sources)
    get_filename_component(base "${source}" NAME)
    if(base STREQUAL name)
      get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${source_dir}")
      file(READ "${path}" original)
    endif()
  endforeach()
  if(NOT DEFINED original)
    message(FATAL_ERROR "interactive trace cannot find ${name}")
  endif()
  if(name STREQUAL "ScreenManager.cpp")
    set(scope_anchor "  if (!get_input_redirected(input.pn)) {")
    string(FIND "${original}" "${scope_anchor}" scope_offset)
    if(scope_offset LESS 0)
      message(FATAL_ERROR "native input clock scope anchor changed")
    endif()
    string(REPLACE "${scope_anchor}" "  ItgmaniaHarnessInputScope harness_input_scope;\n${scope_anchor}" original "${original}")
    # Observe the input that survived native overlay/transition routing, even
    # when the top screen has no Lua callbacks. Keep the observation after
    # native gameplay handling and before authored Lua input callbacks.
    set(input_anchor "  g_ScreenStack.back().m_pScreen->PassInputToLua(input);")
    string(FIND "${original}" "${input_anchor}" input_offset)
    if(input_offset LESS 0)
      message(FATAL_ERROR "native screen-input observer anchor changed")
    endif()
    string(REPLACE "${input_anchor}" "  itgmania_harness_observe_screen_input(input, g_ScreenStack.back().m_pScreen);\n${input_anchor}" original "${original}")
    set(load_anchor "void ScreenManager::PrepareScreen(const std::string& sScreenName) {")
    string(FIND "${original}" "${load_anchor}" load_offset)
    if(load_offset LESS 0)
      message(FATAL_ERROR "native screen-load observer anchor changed")
    endif()
    string(REPLACE "${load_anchor}" "${load_anchor}\n  ItgmaniaHarnessScreenLoad harness_screen_load(sScreenName);" original "${original}")
    set(draw_anchor "void ScreenManager::Draw() {")
    string(REPLACE "${draw_anchor}" "${draw_anchor}\n  ItgmaniaHarnessDrawFrame harness_draw_frame;" original "${original}")
    set(anchor "void ScreenManager::Update(float fDeltaTime) {")
    set(replacement "${anchor}\n  ItgmaniaHarnessUpdateFrame harness_update_frame(fDeltaTime);")
  elseif(name STREQUAL "RageTextureRenderTarget.cpp")
    # Observe after the target and all render matrices have been switched.
    set(begin_anchor "  DISPLAY->LoadIdentity();")
    set(end_anchor "  DISPLAY->SetRenderTarget(m_iPreviousRenderTarget);")
    foreach(boundary begin end)
      string(FIND "${original}" "${${boundary}_anchor}" offset)
      string(FIND "${original}" "${${boundary}_anchor}" last_offset REVERSE)
      if(offset LESS 0 OR NOT offset EQUAL last_offset)
        message(FATAL_ERROR "native render target ${boundary} observer anchor changed")
      endif()
    endforeach()
    string(REPLACE "${begin_anchor}" "${begin_anchor}\n  itgmania_harness_render_target(*this, m_iPreviousRenderTarget, true, bPreserveTexture);" original "${original}")
    set(anchor "${end_anchor}")
    set(replacement "${end_anchor}\n  itgmania_harness_render_target(*this, m_iPreviousRenderTarget, false, false);")
  elseif(name STREQUAL "ScreenGameplay.cpp")
    # Observe the value of the existing timer read. Do not reset or read the
    # timer again and do not export the accumulated stage/player statistics.
    string(REGEX MATCHALL "float fUnscaledDeltaTime = m_timerGameplaySeconds.GetDeltaTime\\(\\)" clock_anchors "${original}")
    list(LENGTH clock_anchors clock_anchor_count)
    if(NOT clock_anchor_count EQUAL 1)
      message(FATAL_ERROR "native gameplay timer observer anchor changed")
    endif()
    set(anchor "      float fUnscaledDeltaTime = m_timerGameplaySeconds.GetDeltaTime();")
    set(replacement "${anchor}\n      itgmania_harness_gameplay_clock(fUnscaledDeltaTime,\n          GAMESTATE->m_SongOptions.GetCurrent().m_fMusicRate,\n          GAMESTATE->m_Position.m_fSongBeat >= GAMESTATE->m_pCurSong->GetFirstBeat() &&\n          GAMESTATE->m_Position.m_fSongBeat < GAMESTATE->m_pCurSong->GetLastBeat());")
  elseif(name STREQUAL "Screen.cpp")
    # Reuse the native event serialization verbatim; do not invent a second
    # mapping of physical buttons, game buttons, controllers, or players.
    set(table_begin "  // Construct the table once, and reuse it.")
    set(table_end "  for (std::map<callback_key_t, LuaReference>::iterator callback =")
    string(FIND "${original}" "${table_begin}" table_start)
    string(FIND "${original}" "${table_end}" table_stop)
    if(table_start LESS 0 OR table_stop LESS table_start)
      message(FATAL_ERROR "native input-event serialization anchors changed")
    endif()
    math(EXPR table_length "${table_stop} - ${table_start}")
    string(SUBSTRING "${original}" ${table_start} ${table_length} input_table)
    string(APPEND original "\nvoid itgmania_harness_observe_screen_input(const InputEventPlus& input, Screen* screen) {\n  Lua* L = LUA->Get();\n  const int top = lua_gettop(L);\n  lua_getglobal(L, \"ITGMANIA_HARNESS_INPUT_EVENT\");\n  const bool observing = lua_isfunction(L, -1);\n  lua_settop(L, top);\n  if (observing) {\n${input_table}    itgmania_harness_observe_input(L, screen);\n    lua_settop(L, top);\n  }\n  LUA->Release(L);\n}\n")
    itgmania_harness_observe_source("${name}" "${original}")
    return()
  elseif(name STREQUAL "Player.cpp")
    # Retain the actual raw timer reads used by Step, before note selection or
    # scoring. Calling Ago again in the later Lua observer loses this timing.
    set(anchor "  const float fTimeSinceStep = tm.Ago();")
    set(replacement "${anchor}\n  itgmania_harness_input_clock(m_pPlayerState->m_PlayerNumber, col, m_pPlayerState->m_Position.m_fMusicSeconds, GAMESTATE->m_SongOptions.GetCurrent().m_fMusicRate, fLastBeatUpdate, fTimeSinceStep, fPositionSeconds);")
  elseif(name STREQUAL "Actor.cpp")
    set(draw_scope_anchor "void Actor::Draw() {")
    string(FIND "${original}" "${draw_scope_anchor}" draw_scope_offset)
    if(draw_scope_offset LESS 0)
      message(FATAL_ERROR "native Actor::Draw scope anchor changed")
    endif()
    string(REPLACE "${draw_scope_anchor}" "${draw_scope_anchor}\n  ItgmaniaHarnessActorDrawScope harness_actor_draw(this);" original "${original}")
    foreach(role "m_FakeParent|-1|    " "state|static_cast<int>(i)|      " "this|0|    ")
      string(REPLACE "|" ";" fields "${role}")
      list(GET fields 0 receiver)
      list(GET fields 1 wrapper)
      list(GET fields 2 indent)
      set(predraw_anchor "${indent}${receiver}->PreDraw();")
      string(FIND "${original}" "${predraw_anchor}" predraw_offset)
      if(predraw_offset LESS 0)
        message(FATAL_ERROR "native PreDraw scope anchor changed: ${receiver}")
      endif()
      string(REPLACE "${predraw_anchor}" "${indent}{\n${indent}  ItgmaniaHarnessPreDrawScope harness_predraw(this, ${receiver}, ${wrapper});\n  ${predraw_anchor}\n${indent}}" original "${original}")
    endforeach()
    foreach(axis "x|0" "y|1" "z|2")
      string(REPLACE "|" ";" fields "${axis}")
      list(GET fields 0 component)
      list(GET fields 1 index)
      set(random_anchor "m_vEffectMagnitude.${component} * randomf(-1.0f, 1.0f) * GetZoom();")
      string(FIND "${original}" "${random_anchor}" random_offset)
      if(random_offset LESS 0)
        message(FATAL_ERROR "native vibrate random input anchor changed: ${component}")
      endif()
      string(REPLACE "${random_anchor}" "m_vEffectMagnitude.${component} * itgmania_harness_vibration_random(this, ${index}, randomf(-1.0f, 1.0f)) * GetZoom();" original "${original}")
    endforeach()
    set(anchor "      this->DrawPrimitives();")
    set(replacement "      Actor* harness_previous = itgmania_harness_draw_actor(this);\n${anchor}\n      itgmania_harness_draw_actor(harness_previous);")
    set(state_anchor "void Actor::SetGlobalRenderStates() {")
    string(REPLACE "${state_anchor}" "${state_anchor}\n  itgmania_harness_render_state(this, m_bZWrite, m_ZTestMode, m_bTextureWrapping, m_bTextureFiltering, m_BlendMode, m_fZBias, m_CullMode);" original "${original}")
  elseif(name STREQUAL "PlayerOptions.cpp" OR name STREQUAL "SongOptions.cpp")
    get_filename_component(kind "${name}" NAME_WE)
    set(anchor "void ${kind}::Approach(const ${kind}& other, float fDeltaSeconds) {")
    if(kind STREQUAL "SongOptions")
      set(song true)
    else()
      set(song false)
    endif()
    set(replacement "${anchor}\n  itgmania_harness_option_delta(this, fDeltaSeconds, ${song});")
  elseif(name STREQUAL "ArrowEffects.cpp")
    string(REPLACE "RageTimer::GetTimeSinceStart()" "itgmania_harness_arrow_clock(RageTimer::GetTimeSinceStart())" original "${original}")
    string(REPLACE "  double fTime = itgmania_harness_arrow_clock(RageTimer::GetTimeSinceStart());" "  double fTime = itgmania_harness_arrow_clock(RageTimer::GetTimeSinceStart());\n  itgmania_harness_arrow_update_clock(fTime);" original "${original}")
    foreach(pair "EFFECT_TIPSY|false" "EFFECT_TAN_TIPSY|true")
      string(REPLACE "|" ";" fields "${pair}")
      list(GET fields 0 effect)
      list(GET fields 1 tangent)
      set(tipsy_anchor "    if (effects[PlayerOptions::${effect}] != 0) {")
      string(REPLACE "${tipsy_anchor}" "${tipsy_anchor}\n      ItgmaniaHarnessArrowCacheScope harness_cache_scope(pn, ${tangent});" original "${original}")
    endforeach()
    set(anchor "  fLastTime = fTime;")
    set(replacement "${anchor}\n  itgmania_harness_after_arrow_update();")
  elseif(name STREQUAL "LuaManager.cpp")
    set(anchor "    const std::string& Error, std::string ErrorType, bool UseAbort) {")
    set(replacement "${anchor}\n  itgmania_harness_script_error(Error);")
  elseif(name STREQUAL "Song.cpp")
    string(REPLACE "#include \"Song.h\"" "#include \"Song.h\"\n#include \"GameState.h\"" original "${original}")
    set(anchor "  float localFirst = FLT_MAX;  // inf")
    set(replacement "  itgmania_harness_catalog_inputs(this, PREFSMAN->m_fGlobalOffsetSeconds, GAMESTATE->m_SongOptions.GetCurrent().m_fMusicRate);\n${anchor}")
  elseif(name STREQUAL "NoteDisplay.cpp")
    set(hold_anchor "    const draw_hold_part_args& part_args, bool glow, int part_type) {")
    string(FIND "${original}" "${hold_anchor}" hold_offset)
    if(hold_offset LESS 0)
      message(FATAL_ERROR "native hold-part observer anchor changed")
    endif()
    string(REPLACE "${hold_anchor}" "${hold_anchor}\n  ItgmaniaHarnessNoteScope harness_hold(m_pPlayerState->m_PlayerNumber, column_args.column, part_args.top_beat, column_args.song_beat, part_type, false, \"hold_strip\");" original "${original}")
    set(anchor "    bool is_being_held) {")
    set(replacement "${anchor}\n  ItgmaniaHarnessNoteScope harness_note(m_pPlayerState->m_PlayerNumber, column_args.column, fBeat, column_args.song_beat, static_cast<int>(part), is_being_held, \"actor\");")
  elseif(name STREQUAL "ReceptorArrowRow.cpp")
    set(alpha_anchor "    m_ReceptorArrow[c]->SetBaseAlpha(fBaseAlpha);")
    string(FIND "${original}" "${alpha_anchor}" alpha_offset)
    if(alpha_offset LESS 0)
      message(FATAL_ERROR "native receptor alpha observer anchor changed")
    endif()
    string(REPLACE "${alpha_anchor}" "${alpha_anchor}\n    itgmania_harness_receptor_alpha(m_ReceptorArrow[c], fBaseAlpha);" original "${original}")
    set(anchor "    m_ReceptorArrow[c]->Draw();")
    set(replacement "    ItgmaniaHarnessReceptorScope harness_receptor(m_ReceptorArrow[c], m_pPlayerState->m_PlayerNumber, c, m_pPlayerState->m_Position.m_fSongBeatVisible);\n${anchor}")
  elseif(name STREQUAL "Model.cpp")
    foreach(texture diffuse alpha)
      set(texture_anchor "mat.${texture}.GetCurrentTexture()->GetTexHandle()")
      string(FIND "${original}" "${texture_anchor}" texture_offset)
      if(texture_offset LESS 0)
        message(FATAL_ERROR "native Model texture observer anchor changed: ${texture}")
      endif()
      string(REPLACE "${texture_anchor}" "itgmania_harness_model_texture_handle(mat.${texture}.GetCurrentTexture())" original "${original}")
    endforeach()
    set(anchor "  DISPLAY->DrawCompiledGeometry(TempGeometry, i, m_pGeometry->m_Meshes);")
    set(replacement "  ItgmaniaHarnessModelMeshScope harness_model_mesh(m_pTempGeometry ? &m_vTempMeshes[i] : pMesh);\n${anchor}")
  elseif(name STREQUAL "RageDisplay_OGL.cpp")
    set(material_anchor "void RageDisplay_Legacy::SetMaterial(\n    const RageColor& emissive, const RageColor& ambient,\n    const RageColor& diffuse, const RageColor& specular, float shininess) {")
    set(texture_anchor "void RageDisplay_Legacy::SetTextureMode(TextureUnit tu, TextureMode tm) {\n  if (!SetTextureUnit(tu)) {\n    return;\n  }")
    foreach(anchor IN ITEMS "${material_anchor}" "${texture_anchor}")
      string(FIND "${original}" "${anchor}" offset)
      if(offset LESS 0)
        message(FATAL_ERROR "native OpenGL Model state observer anchor changed")
      endif()
    endforeach()
    string(REPLACE "${material_anchor}" "${material_anchor}\n  itgmania_harness_model_material(emissive, ambient, diffuse, specular, shininess);" original "${original}")
    string(REPLACE "${texture_anchor}" "${texture_anchor}\n  itgmania_harness_model_texture_mode(tu, tm);" original "${original}")
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/model_render_state_gl.inc" model_gl_observer)
    string(APPEND original "\n${model_gl_observer}\n")
    set(anchor "  p->Draw(iMeshIndex);")
    set(replacement "  itgmania_harness_draw_model_gl_current(iMeshIndex, *GetWorldTop(), *GetViewTop(), *GetProjectionTop());\n${anchor}")
  elseif(name STREQUAL "RageDisplay.cpp")
    set(model_draw "this->DrawCompiledGeometryInternal(p, iMeshIndex);")
    string(FIND "${original}" "${model_draw}" model_offset)
    if(model_offset LESS 0)
      message(FATAL_ERROR "native compiled model draw anchor changed")
    endif()
    string(REPLACE "${model_draw}" "itgmania_harness_draw_model_current(iMeshIndex, *GetWorldTop(), *GetViewTop(), *GetProjectionTop());\n  ${model_draw}" original "${original}")
    foreach(primitive Quads QuadStrip Fan Strip Triangles SymmetricQuadStrip)
      set(draw "this->Draw${primitive}Internal(v, iNumVerts);")
      string(FIND "${original}" "${draw}" offset)
      if(offset LESS 0)
        message(FATAL_ERROR "native draw anchor changed: ${primitive}")
      endif()
      string(REPLACE "${draw}" "itgmania_harness_draw_vertices(\"${primitive}\", v, iNumVerts, *GetWorldTop(), *GetViewTop(), *GetProjectionTop(), *GetCentering(), *GetTextureTop());\n  ${draw}" original "${original}")
    endforeach()
    itgmania_harness_observe_source("${name}" "${original}")
    return()
  elseif(name STREQUAL "CrashHandlerChild.cpp")
    # Retain the native crash report while suppressing the desktop dialog.
    get_filename_component(local_dir "${path}" DIRECTORY)
    foreach(header Crash.h CrashHandlerInternal.h)
      string(REPLACE "#include \"${header}\"" "#include \"${local_dir}/${header}\"" original "${original}")
    endforeach()
    set(anchor "  CrashDialog cd(sCrashReport, Data);")
    set(replacement "  if (GetEnvironmentVariableA(\"ITGMANIA_HARNESS_HEADLESS\", nullptr, 0)) return;\n${anchor}")
  elseif(name STREQUAL "LowLevelWindow_X11.cpp")
    # GLX can retain its real context and render-to-texture implementation on
    # an unmapped window. Do not map it, or wait for a MapNotify that cannot
    # arrive. This branch is also usable with an isolated Xvfb display.
    get_filename_component(local_dir "${path}" DIRECTORY)
    string(REPLACE "#include \"LowLevelWindow_X11.h\"" "#include \"${local_dir}/LowLevelWindow_X11.h\"" original "${original}")
    string(PREPEND original "#include <cstdlib>\nstatic bool harness_headless_graphics() { return std::getenv(\"ITGMANIA_HARNESS_HEADLESS_GRAPHICS\") != nullptr; }\n")
    set(mode_anchor "std::string LowLevelWindow_X11::TryVideoMode(\n    const VideoModeParams& p, bool& bNewDeviceOut) {")
    string(FIND "${original}" "${mode_anchor}" mode_offset)
    if(mode_offset LESS 0)
      message(FATAL_ERROR "headless X11 video-mode anchor changed")
    endif()
    string(REPLACE "${mode_anchor}" "${mode_anchor}\n  if (harness_headless_graphics() && (!p.windowed || p.bWindowIsFullscreenBorderless)) {\n    return \"Headless graphics requires a normal windowed GLX context.\";\n  }" original "${original}")
    set(anchor "    XMapWindow(Dpy, Win);\n\n    XEvent ev;\n    do {\n      XWindowEvent(Dpy, Win, StructureNotifyMask, &ev);\n    } while (ev.type != MapNotify);")
    set(replacement "    if (!harness_headless_graphics()) {\n      XMapWindow(Dpy, Win);\n\n      XEvent ev;\n      do {\n        XWindowEvent(Dpy, Win, StructureNotifyMask, &ev);\n      } while (ev.type != MapNotify);\n    }")
  elseif(name STREQUAL "GraphicsWindow.cpp")
    # Keep the real WGL renderer and native AFT implementation, but never show
    # or activate its context window during headless graphics observations.
    get_filename_component(local_dir "${path}" DIRECTORY)
    foreach(header GraphicsWindow.h DirectXHelpers.h)
      string(REPLACE "#include \"${header}\"" "#include \"${local_dir}/${header}\"" original "${original}")
    endforeach()
    string(PREPEND original "#include <cstdlib>\nstatic bool harness_headless_graphics() { return std::getenv(\"ITGMANIA_HARNESS_HEADLESS_GRAPHICS\") != nullptr; }\n")
    foreach(call "SetForegroundWindow(hWnd)" "SetForegroundWindow(g_hWndMain)"
        "ShowWindow(g_hWndMain, SW_SHOWNORMAL)" "ShowWindow(g_hWndMain, SW_SHOWMINNOACTIVE)")
      string(FIND "${original}" " ${call}" offset)
      if(offset LESS 0)
        message(FATAL_ERROR "headless graphics window anchor changed: ${call}")
      endif()
      string(REPLACE " ${call}" " if (!harness_headless_graphics()) ${call}" original "${original}")
    endforeach()
    set(anchor "SWP_FRAMECHANGED | SWP_SHOWWINDOW")
    set(replacement "SWP_FRAMECHANGED | (harness_headless_graphics() ? SWP_NOACTIVATE : SWP_SHOWWINDOW)")
  endif()
  string(FIND "${original}" "${anchor}" offset)
  if(offset LESS 0)
    message(FATAL_ERROR "native interactive anchor changed: ${name}")
  endif()
  string(REPLACE "${anchor}" "${replacement}" original "${original}")
  itgmania_harness_observe_source("${name}" "${original}")
endfunction()

function(itgmania_harness_trace_adapter)
  # Stamp the executable's own source, not the Rust CLI's pinned oracle.
  execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
    OUTPUT_VARIABLE native_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND git diff --quiet HEAD -- src
    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}" RESULT_VARIABLE native_dirty)
  if(NOT native_dirty MATCHES "^[01]$")
    message(FATAL_ERROR "Cannot determine native source modifications")
  endif()
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/NoteDisplay.cpp" note_display_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/ReceptorArrowRow.cpp" receptor_arrow_row_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/CubicSpline.cpp" cubic_spline_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/Actor.cpp" actor_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/RageUtil/RandomNumbers.cpp" random_numbers_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/RageUtil/RandomNumbers.h" random_numbers_header_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/ScreenGameplay.cpp" screen_gameplay_sha256)
  file(SHA256 "${CMAKE_SOURCE_DIR}/src/RageTextureRenderTarget.cpp" render_target_sha256)
  file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/itgmania-harness/source_provenance.h" CONTENT
    "#define HARNESS_NATIVE_REVISION \"@native_revision@\"\n#define HARNESS_NATIVE_DIRTY @native_dirty@\n#define HARNESS_NOTE_DISPLAY_SHA256 \"@note_display_sha256@\"\n#define HARNESS_RECEPTOR_ARROW_ROW_SHA256 \"@receptor_arrow_row_sha256@\"\n#define HARNESS_CUBIC_SPLINE_SHA256 \"@cubic_spline_sha256@\"\n#define HARNESS_ACTOR_SHA256 \"@actor_sha256@\"\n#define HARNESS_RANDOM_NUMBERS_SHA256 \"@random_numbers_sha256@\"\n#define HARNESS_RANDOM_NUMBERS_HEADER_SHA256 \"@random_numbers_header_sha256@\"\n#define HARNESS_SCREEN_GAMEPLAY_SHA256 \"@screen_gameplay_sha256@\"\n#define HARNESS_RENDER_TARGET_SHA256 \"@render_target_sha256@\"\n" @ONLY)
  target_include_directories(ITGmania PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/itgmania-harness")
  # Compile an observed copy; never patch the checked-out reference tree.
  get_target_property(sources ITGmania SOURCES)
  get_target_property(source_dir ITGmania SOURCE_DIR)
  set(actor_util_count 0)
  foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "ActorUtil.cpp")
      math(EXPR actor_util_count "${actor_util_count} + 1")
      get_filename_component(actor_util "${source}" ABSOLUTE BASE_DIR "${source_dir}")
      list(REMOVE_ITEM sources "${source}")
    endif()
  endforeach()
  if(NOT actor_util_count EQUAL 1)
    message(FATAL_ERROR "trace adapter requires exactly one native ActorUtil.cpp")
  endif()
  file(READ "${actor_util}" original)
  set(anchor "  pRet->LoadFromNode(&node);")
  # Exclude the semicolon: CMake treats it as a list separator in MATCHALL.
  string(REGEX MATCHALL "  pRet->LoadFromNode\\(&node\\)" anchors "${original}")
  list(LENGTH anchors anchor_count)
  if(NOT anchor_count EQUAL 1)
    message(FATAL_ERROR "native actor creation observer anchor changed")
  endif()
  string(REPLACE "${anchor}" "  itgmania_harness_actor_created(pRet, &node);\n${anchor}" observed "${original}")
  if(observed STREQUAL original)
    message(FATAL_ERROR "native actor creation observer insertion failed")
  endif()
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/itgmania-harness/ActorUtil.cpp")
  file(CONFIGURE OUTPUT "${generated}" CONTENT
    "class Actor;\nclass XNode;\nvoid itgmania_harness_actor_created(Actor*, const XNode*);\n${observed}" @ONLY)
  set_property(TARGET ITGmania PROPERTY SOURCES "${sources}")
  target_sources(ITGmania PRIVATE "${generated}")
  target_sources(ITGmania PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/trace_adapter.cpp")
  target_sources(ITGmania PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/interactive_trace.cpp")
  foreach(name ScreenManager.cpp ScreenGameplay.cpp Screen.cpp Player.cpp Actor.cpp NoteDisplay.cpp ReceptorArrowRow.cpp Model.cpp RageDisplay.cpp RageTextureRenderTarget.cpp PlayerOptions.cpp SongOptions.cpp Song.cpp ArrowEffects.cpp LuaManager.cpp)
    itgmania_harness_interactive_source("${name}")
  endforeach()
  get_target_property(renderer_sources ITGmania SOURCES)
  foreach(source IN LISTS renderer_sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "RageDisplay_OGL.cpp")
      itgmania_harness_interactive_source("${name}")
      break()
    endif()
  endforeach()
  if(WIN32)
    itgmania_harness_interactive_source("GraphicsWindow.cpp")
    itgmania_harness_interactive_source("CrashHandlerChild.cpp")
  else()
    foreach(source IN LISTS renderer_sources)
      get_filename_component(name "${source}" NAME)
      if(name STREQUAL "LowLevelWindow_X11.cpp")
        itgmania_harness_interactive_source("${name}")
        # Advertise the capability only when the real X11 window source was
        # observed above; other Unix window backends remain unsupported.
        target_compile_definitions(ITGmania PRIVATE ITGMANIA_HARNESS_X11_HEADLESS_GRAPHICS=1)
        break()
      endif()
    endforeach()
  endif()
  # Retain the stock executable for historical captures and independent checks.
  set(ITGMANIA_HARNESS_TRACE_NAME "ITGmania-harness-trace" CACHE STRING "Separate native trace executable name")
  set_target_properties(ITGmania PROPERTIES OUTPUT_NAME_RELEASE "${ITGMANIA_HARNESS_TRACE_NAME}")
  if(MSVC)
    # The upstream post-build mapconv command also reads the original name.
    # Without an explicit map path a fresh renamed build fails after linking.
    set_property(TARGET ITGmania APPEND_STRING PROPERTY LINK_FLAGS_RELEASE
      " /MAP:\"${CMAKE_SOURCE_DIR}/Program/ITGmania.map\"")
    # Upstream's mapconv command still writes the original product filename.
    # CrashHandler looks for a sidecar matching this adapter's executable.
    add_custom_target(itgmania-harness-crash-symbols
      DEPENDS ITGmania
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "$<TARGET_FILE_DIR:ITGmania>/ITGmania.vdi"
        "$<TARGET_FILE_DIR:ITGmania>/${ITGMANIA_HARNESS_TRACE_NAME}.vdi")
  endif()
endfunction()
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  cmake_language(DEFER CALL itgmania_harness_trace_adapter)
endif()
